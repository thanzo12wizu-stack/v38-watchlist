+def _monitor_band(rsi_value: float | None) -> str:
+    if not _finite(rsi_value):
+        return "DATA_REQUIRED"
+    value = float(rsi_value)
+    if value <= 30.0:
+        return "RSI30_OR_BELOW"
+    if value <= 35.0:
+        return "WITHIN_5PT"
+    if value <= 40.0:
+        return "WITHIN_10PT"
+    return "WATCHING"
+
