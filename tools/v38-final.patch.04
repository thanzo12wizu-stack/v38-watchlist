+++ b/tests/test_v38_sleeve_live.py
@@ -0,0 +1,43 @@
+import json
+
+from build_v38_sleeve_live import _merge_desired_into_tqqq, _monitor_band, advance_normal
+
+
+def test_monitor_bands_are_display_only_thresholds():
+    assert _monitor_band(29.9) == "RSI30_OR_BELOW"
+    assert _monitor_band(34.9) == "WITHIN_5PT"
+    assert _monitor_band(39.9) == "WITHIN_10PT"
+    assert _monitor_band(45.0) == "WATCHING"
+    assert _monitor_band(None) == "DATA_REQUIRED"
+
+
+def test_merge_desired_into_tqqq_requires_same_asof_and_ready(tmp_path):
+    path = tmp_path / "tqqq.json"
+    path.write_text(json.dumps({"asof": "2026-08-28", "live_generation_status": "READY",
+                                "underlying_target_pct": 30, "requested_target_pct": 30}), encoding="utf-8")
+    _merge_desired_into_tqqq(path, "2026-08-28", 86.0, 5.8, "READY")
+    ready = json.loads(path.read_text(encoding="utf-8"))
+    assert ready["sleeve_live_status"] == "READY"
+    assert ready["normal_stock_desired_pct"] == 86.0
+    assert ready["reset_desired_pct"] == 5.8
+    _merge_desired_into_tqqq(path, "2026-08-27", 86.0, 5.8, "READY")
+    stale = json.loads(path.read_text(encoding="utf-8"))
+    assert stale["sleeve_live_status"] == "DATA REQUIRED"
+    assert stale["normal_stock_desired_pct"] is None
+    assert stale["reset_desired_pct"] is None
+
+
+def test_same_session_normal_seed_marks_exposure_and_keeps_stop_mode_no_entries():
+    previous = {"status": "READY", "asof": "2026-08-28", "cash": 20.0,
+                "positions": [{"symbol": "AAA", "shares": 1.0, "entry_price": 100.0,
+                               "entry_date": "2026-08-01", "peak_close": 110.0,
+                               "partial_done": False, "close": 105.0}],
+                "pending": {"full_exits": [], "partial25": [], "entries": []}}
+    companion = {"market": {"mode": "STOP", "new_entry_limit": 0},
+                 "ranking": {"strict_loo_live_status": "READY"}, "candidates": []}
+    state = advance_normal(previous, companion, "2026-08-28")
+    assert state["status"] == "READY"
+    assert state["position_count"] == 1
+    assert round(state["desired_pct"], 6) == round(105.0 / 125.0 * 100.0, 6)
+    assert state["pending"]["entries"] == []
+    assert state["pending"]["entry_cap"] == 0
--- /dev/null
+++ b/.github/workflows/v38-sleeve-live-once.yml
@@ -0,0 +1,74 @@
+name: V38 sleeve live smoke once
+
+on:
+  push:
+    branches: [fix/v38-gross100-live-20260901]
+    paths:
+      - 'build_v38_sleeve_live.py'
+      - 'build_v38_companion.py'
+      - 'v38-normal-sleeve-seed.json'
+      - '.github/workflows/v38-sleeve-live-once.yml'
+
+permissions:
+  contents: read
+
+jobs:
+  smoke:
+    runs-on: ubuntu-24.04
+    timeout-minutes: 45
+    steps:
+      - uses: actions/checkout@v7
+      - uses: actions/setup-python@v7
+        with:
+          python-version: '3.11'
+      - run: pip install --disable-pip-version-check -r requirements.txt pytest
+      - name: Compile and unit tests
+        run: |
+          python -m py_compile build_v38_sleeve_live.py build_v38_companion.py
+          pytest -q tests/test_v38_sleeve_live.py tests/test_v38_companion.py
+      - name: Build live sleeve snapshot
+        run: |
+          cp tqqq-panic-state.json /tmp/tqqq-panic-state.json
+          python build_v38_sleeve_live.py \
+            --companion v38-live-state.json \
+            --state /tmp/no-prior-sleeve.json \
+            --seed v38-normal-sleeve-seed.json \
+            --strict-history v38-strict-loo-history.json \
+            --tqqq-state /tmp/tqqq-panic-state.json \
+            --out /tmp/v38-sleeve-state.json
+          python build_v38_companion.py \
+            --legacy command-center.html \
+            --universe universe.csv \
+            --strict-loo v38-strict-loo-live.json \
+            --tqqq-panic /tmp/tqqq-panic-state.json \
+            --sleeve-state /tmp/v38-sleeve-state.json \
+            --out /tmp/v38-live-state.json
+          python - <<'PY2'
+          import json
+          from pathlib import Path
+          sleeve=json.loads(Path('/tmp/v38-sleeve-state.json').read_text())
+          live=json.loads(Path('/tmp/v38-live-state.json').read_text())
+          assert sleeve['status']=='READY', sleeve
+          assert live['gross100_allocation']['status']=='LIVE ALLOCATION READY', live['gross100_allocation']
+          assert live['panic_reset']['status']=='READY / LIVE', live['panic_reset']
+          print(json.dumps({
+            'asof':live['asof'],
+            'normal_desired':live['gross100_allocation']['normal_stock_desired_pct'],
+            'reset_desired':live['gross100_allocation']['reset_desired_pct'],
+            'tqqq_desired':live['gross100_allocation']['tqqq_desired_pct'],
+            'normal_final':live['gross100_allocation']['normal_stock_allocated_pct'],
+            'reset_final':live['gross100_allocation']['reset_allocated_pct'],
+            'tqqq_final':live['gross100_allocation']['tqqq_allocated_pct'],
+            'gross':live['gross100_allocation']['gross_allocated_pct'],
+            'reset_monitor':live['panic_reset'].get('monitor_summary',{}),
+            'nearest':(live['panic_reset'].get('monitor') or [])[:10],
+          }, ensure_ascii=False, indent=2))
+          PY2
+      - uses: actions/upload-artifact@v4
+        with:
+          name: v38-sleeve-live-smoke
+          path: |
+            /tmp/v38-sleeve-state.json
+            /tmp/v38-live-state.json
+            /tmp/tqqq-panic-state.json
+          retention-days: 2
