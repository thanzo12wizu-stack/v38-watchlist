function renderRotation(){if(!ROT){$('rotStrong').textContent=$('rotWatch').textContent=$('rotWeak').textContent='Rotationデータ取得失敗。正式V38順位には影響なし。';return}let b=ROT.observations?.rotation_buckets||{};let names=a=>(a||[]).map(x=>x.ticker).join(' / ')||'なし';$('rotStrong').textContent=names(b.mainstream)+'。現在強いという観測で、買いシグナルではありません。';$('rotWatch').textContent=names([...(b.watch||[]),...(b.flow_internal_divergence||[])])+'。先行/乖離の監視。';$('rotWeak').textContent=names([...(b.distribution||[]),...(b.weak_flow_out||[]),...(b.breakdown||[])])+'。警戒Context。Rotation単独で強制売却しません。';if(STATE)renderRanking()}
async function load(){try{STATE=await fetch('v38-live-state.json',{cache:'no-store'}).then(r=>r.json());$('asof').textContent=`分析基準日 ${STATE.asof} ／ Source: ${STATE.source}`;renderPositions();renderToday();renderTqqq();renderResetWatch()}catch{$('asof').textContent='V38 state DATA REQUIRED';return}try{ROT=await fetch('https://raw.githubusercontent.com/thanzo12wizu-stack/v38-watchlist/research/rotation-exact-flow-internals-20260831/leadership/research/rotation_daily_observation_brief/daily_observation_brief.json',{cache:'no-store'}).then(r=>r.json());if(ROT.asof!==STATE.asof)ROT=null}catch{ROT=null}try{ROTCTX=await fetch('https://raw.githubusercontent.com/thanzo12wizu-stack/v38-watchlist/research/rotation-exact-flow-internals-20260831/leadership/research/rotation_theme_stock_context/rotation_theme_stock_context.json',{cache:'no-store'}).then(r=>r.json());if(ROTCTX.leadership_coverage?.market_asof!==STATE.asof)ROTCTX=null}catch{ROTCTX=null}renderRotation()}
load();
</script></body></html>
