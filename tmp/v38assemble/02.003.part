function rotationFor(ticker){if(!ROTCTX)return null;let found=[];for(const row of ROTCTX.industry_context||[]){for(const key of['existing_emerging_or_leading_leaders_in_full_intersection','existing_leadership_leaders_in_top15_intersection']){for(const s of row[key]||[]){if(s.symbol===ticker)found.push({etf:row.etf,state:row.rotation?.state,reason:row.rotation?.state_reason})}}}return found[0]||null}
function rotationLabel(x){let r=rotationFor(x.ticker);if(!r)return'Rotation: 正式順位には未使用';let state=r.state||'';let jp=state.includes('DISTRIBUTION')||state.includes('WEAK')?'警戒Context':state.includes('CURRENT_STRENGTH')?'現在強い':state.includes('LEAD')||state.includes('EARLY')?'先行WATCH':'参考';return`${r.etf} / ${jp}`}
function whyText(x){let parts=[];parts.push(`RS189 ${fmt(x.rs189)} / RS63 ${fmt(x.rs63)}`);if(x.peer_theme)parts.push(`${x.peer_theme}のLOO Theme Score ${fmt(x.peer_theme_score)}`);else parts.push('有効Themeなし → Final計算だけ中立50');return parts.join('。')+'。'}
function pickCard(x){let q=rankMeta(x),can=STATE.market.mode==='ATTACK'||STATE.market.mode==='SELECTIVE';return`<div class="pick"><div class="rankno">#${q.rank??'—'} ${can?'買付優先順位':'再開時ウォッチ'}</div><div class="ticker">${esc(x.ticker)}</div><div class="pickline">$${fmt(x.price,2)} ／ ${esc(x.peer_theme||'Themeなし')}</div><div class="score">${q.score==null?'DATA REQUIRED':fmt(q.score,1)}</div><div class="pickline">${q.label} Score</div><span class="rotchip">${esc(rotationLabel(x))}</span><div class="why">${esc(whyText(x))}</div></div>`}
function renderRanking(){let rows=rankRows(),m=STATE.market,r=STATE.ranking||{},entry=m.mode==='ATTACK'||m.mode==='SELECTIVE';let ready=entry?(m.mode==='SELECTIVE'||r.strict_loo_live_status==='READY'):r.attack_watch_status==='READY';$('rankingTitle').textContent=entry?'今日の買付優先順位':'再開したら見る順番';$('rankingSubtitle').textContent=entry?'空き枠がある場合、この順に翌営業日寄りの候補。':'今は買わない。Market Modeが再開した時の候補を先に準備しています。';$('rankingBadge').textContent=ready?'正式ロジックで順位化':'DATA REQUIRED';$('rankStatus').textContent=ready?'順位READY':'DATA REQUIRED';$('quickRankTitle').textContent=entry?'今、優先して見る銘柄':'再開時にまず見る銘柄';$('quickRankExplain').textContent=entry?'現在のModeと空き枠が許す範囲で、上から優先します。':'現在は新規買付不可。下は「もし市場が再開したら何から見るか」で、買い推奨ではありません。';let top=ready?rows.slice(0,3):[];$('quickPicks').innerHTML=top.map(pickCard).join('')||'<div class="empty">正式順位に必要なデータが揃っていません。</div>';$('topPicks').innerHTML=top.map(pickCard).join('')||'<div class="empty">正式順位に必要なデータが揃っていません。</div>';$('candidateRows').innerHTML=rows.map(x=>{let q=rankMeta(x),rot=rotationLabel(x);return`<tr><td>${q.rank??'—'}</td><td><b>${esc(x.ticker)}</b></td><td>${q.score==null?'DATA REQUIRED':fmt(q.score,1)}</td><td>${fmt(x.rs189)}</td><td>${fmt(x.rs63)}</td><td>${esc(x.peer_theme||'—')}</td><td>${x.peer_theme_score==null?'—':fmt(x.peer_theme_score)}</td><td>${esc(rot)}</td><td>${entry?'空き枠があれば候補':'今は買わない'}</td></tr>`}).join('')}
function renderToday(){if(!STATE)return;let m=STATE.market,held=positions().length,mt=modeText(m);$('modeHuman').textContent=mt[0];$('modeHuman').className='v '+mt[2];$('modeHumanReason').textContent=mt[1];$('nqsarHuman').textContent=m.nqsar||'—';$('nqsarHuman').className='v '+(String(m.nqsar).toLowerCase()==='red'?'bad':String(m.nqsar).toLowerCase()==='yellow'?'warn':'good');$('breadthHuman').textContent=fmt(m.breadth50)+'%';$('todayReason').textContent=humanReason(m);$('mode').textContent=m.mode;$('breadth').textContent=`${fmt(m.breadth50)}% / ${(m.coverage*100).toFixed(1)}%`;$('capacity').textContent=m.new_entry_limit;$('looStatus').textContent=STATE.ranking?.attack_watch_status||STATE.ranking?.strict_loo_live_status||'—';if(m.mode==='DEFENSE'){$('todayAction').textContent='通常株は次回寄りで全退避';$('normalDecision').textContent='新規0・全退避';$('holdingDecision').textContent=held?'次回寄りで全退避':'保有なし'}else if(m.mode==='STOP'){$('todayAction').textContent='今日は通常株を新規で買わない';$('normalDecision').textContent='新規0';$('holdingDecision').textContent=held?`${held}銘柄を個別Exitまで継続`:'保有なし'}else{let cap=Math.max(0,m.new_entry_limit-held);$('todayAction').textContent=cap>0?`通常株を最大${cap}銘柄まで追加可能`:'今日は通常株を追加しない';$('normalDecision').textContent=`最大${m.new_entry_limit}枠`;$('holdingDecision').textContent=held?`${held}銘柄保有`:'保有なし'}$('resumeCondition').textContent=m.mode==='STOP'||m.mode==='DEFENSE'?'Blue/Green＋Breadth≥50%':'現在Entry資格あり';renderRanking()}
function renderResetWatch(){let r=STATE?.panic_reset||{},m=Array.isArray(r.monitor)?r.monitor:[],ready=String(r.status||'').startsWith('READY');$('resetMonitorStatus').textContent=ready?'LIVE / READY':'DATA REQUIRED';$('resetHeld').textContent=ready?`${(r.positions||[]).length} / 4`:'—';$('resetDesired').textContent=ready?pct(r.desired_pct):'—';$('resetTouched').textContent=ready?m.filter(x=>x.touched30&&!x.signal_date).length:'—';$('resetNear').textContent=ready?m.filter(x=>x.rsi14!=null&&Number(x.rsi14)<=35&&!x.touched30).length:'—';if(!ready){$('resetMonitorRows').innerHTML='<tr><td colspan="9" class="datareq">Reset監視データが未取得です。</td></tr>';return}$('resetMonitorRows').innerHTML=m.map(x=>{let stage=esc(x.stage||'監視中'),near=x.rsi14!=null&&Number(x.rsi14)<=35,cls=String(x.stage||'').includes('SIGNAL')?'good':x.touched30?'warn':near?'warn':'';return`<tr><td class="${cls}"><b>${stage}</b></td><td><b>${esc(x.symbol)}</b></td><td>${x.rsi14==null?'—':fmt(x.rsi14,1)}</td><td>${x.distance_to_30==null?'—':fmt(x.distance_to_30,1)+'pt'}</td><td>${x.rsi_rising_today?'↑ YES':'—'}</td><td>${x.signal_top3_today?'YES':'NO'}</td><td>${esc(x.theme||'—')}</td><td>${esc(x.day0_date||'—')}</td><td>${x.days_remaining==null?'—':x.days_remaining}</td></tr>`}).join('')||'<tr><td colspan="9" class="mut">現在、Activation後20日以内の監視対象はありません。</td></tr>'}
function renderTqqq(){let p=STATE.panic_tqqq||{},n=STATE.normal_tqqq||{};$('tqqqDecision').textContent=n.status==='READY'?`目標 ${pct(n.underlying_target_pct)}`:'判定不可';let active=!!p.active;$('tqqqPlain').textContent=active?'Panic F80が稼働中。CURRENT30の目標を最低80%へ引き上げています。':`Panic F80は未発動。現在はCURRENT30 hierarchyの目標 ${pct(n.underlying_target_pct)}。30%は通常baseで固定値ではありません。`;$('panicPlain').textContent=active?'F80稼働中':'未発動';$('rsiTrigger').textContent=p.rsi4h==null?'DATA REQUIRED':p.touch30_today?'TOUCH30成立':`RSI ${fmt(p.rsi4h)}`;$('mcEntry').textContent=p.mc57==null?'DATA REQUIRED':`${fmt(p.mc57)} / ${p.mc57>=20?'Entry可':'Entry不可'}`;$('seed').textContent=p.seed_age_sessions!=null&&p.seed_age_sessions>=0&&p.seed_age_sessions<=30?'Seed有効':'Seedなし/期限外';$('seedAge').textContent=p.seed_age_sessions==null?'—':`age=${p.seed_age_sessions}`;$('vix').textContent=fmt(p.vix_close,2);$('atrDev').textContent=fmt(p.qqq_sma50_atr_deviation,2);$('dd10').textContent=p.qqq_drawdown10==null?'—':(p.qqq_drawdown10*100).toFixed(2)+'%';$('requestedTarget').textContent=pct(p.requested_target_pct);$('holdDays').textContent=active?Math.max(0,10-(p.held_sessions||0)):'—';$('mcExit').textContent=active&&p.mc57<20?'次回寄りEXIT':'未発動';let g=STATE.gross100_allocation||{},ready=String(g.status||'').includes('LIVE ALLOCATION READY');if(ready){$('resetAllocation').textContent=`${pct(g.reset_desired_pct)} / ${pct(g.reset_allocated_pct)}`;$('tqqqParts').textContent=`${pct(g.tqqq_protected_pct)} / ${pct(g.tqqq_extra_pct)}`;$('normalAllocation').textContent=`${pct(g.normal_stock_desired_pct)} / ${pct(g.normal_stock_allocated_pct)}`;$('executableTarget').textContent=`${pct(g.tqqq_allocated_pct)} / Gross ${pct(g.gross_allocated_pct)}`}}
