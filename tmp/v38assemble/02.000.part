<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>V38 運用ダッシュボード</title>
<style>
:root{--bg:#09111d;--panel:#111d2c;--panel2:#162438;--line:#263951;--text:#eef5ff;--muted:#9fb0c6;--good:#6fd3a2;--warn:#ffd166;--bad:#ff7d8c;--blue:#72a7ff;--chip:#1c2d44}*{box-sizing:border-box}body{margin:0;background:linear-gradient(180deg,#08101b,#0c1624 38%,#08111c);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","Noto Sans JP",sans-serif}.wrap{max-width:1180px;margin:auto;padding:18px}.top{display:flex;gap:14px;align-items:flex-start;justify-content:space-between;margin-bottom:14px}.brand h1{font-size:24px;margin:0 0 5px}.sub{color:var(--muted);font-size:13px}.asof{font-size:12px;color:var(--muted);text-align:right}.tabs{position:sticky;top:0;z-index:10;display:flex;gap:7px;overflow:auto;padding:9px 0;background:rgba(9,17,29,.94);backdrop-filter:blur(12px)}.tabs button{white-space:nowrap;border:1px solid var(--line);background:#0d1928;color:var(--muted);padding:9px 12px;border-radius:999px;font-weight:700}.tabs button.on{background:#20334e;color:#fff;border-color:#45648c}.panel{display:none}.panel.on{display:block}.card{background:linear-gradient(180deg,var(--panel),#0f1a28);border:1px solid var(--line);border-radius:15px;padding:16px;margin:12px 0;box-shadow:0 12px 28px rgba(0,0,0,.14)}.hero{padding:20px;border-color:#345071}.eyebrow{font-size:12px;color:var(--blue);font-weight:800;letter-spacing:.05em}.hero-title{font-size:30px;font-weight:850;line-height:1.2;margin:7px 0}.hero-reason{font-size:15px;color:#cbd8e8;line-height:1.65}.row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:14px}.mini{background:var(--panel2);border:1px solid var(--line);border-radius:12px;padding:12px}.mini span{display:block;font-size:11px;color:var(--muted);margin-bottom:5px}.mini b{font-size:17px}.good{color:var(--good)}.warn{color:var(--warn)}.bad{color:var(--bad)}.mut{color:var(--muted)}.hdr{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}.hdr h2{font-size:18px;margin:0}.badge{font-size:11px;padding:5px 8px;border-radius:999px;background:var(--chip);color:#c9d8eb;border:1px solid var(--line)}.explain{color:#c9d6e5;font-size:13px;line-height:1.65}.action-strip{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:10px}.action-box{background:#132137;border:1px solid #2c4361;border-radius:13px;padding:14px}.action-box .k{font-size:11px;color:var(--muted)}.action-box .v{font-size:20px;font-weight:850;margin:4px 0}.action-box .d{font-size:12px;color:#b7c5d7;line-height:1.5}.rank-intro{display:flex;align-items:center;justify-content:space-between;gap:12px}.rank-intro strong{font-size:20px}.picks{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:12px}.pick{background:linear-gradient(180deg,#182a42,#101d2e);border:1px solid #314968;border-radius:15px;padding:15px;position:relative}.pick:first-child{border-color:#557db2;box-shadow:0 0 0 1px rgba(114,167,255,.15)}.rankno{font-size:12px;color:var(--blue);font-weight:800}.ticker{font-size:27px;font-weight:900;margin:3px 0}.pickline{font-size:12px;color:#c3d1e2;line-height:1.55}.score{font-size:20px;font-weight:850;margin:8px 0 2px}.why{margin-top:8px;padding-top:8px;border-top:1px solid var(--line);font-size:12px;line-height:1.55;color:#b8c7d9}.rotchip{display:inline-flex;margin-top:8px;font-size:11px;border:1px solid var(--line);border-radius:999px;padding:4px 7px;background:#0e1b2c;color:#bfd0e3}.ranktable{width:100%;border-collapse:collapse;font-size:12px}.ranktable th,.ranktable td{padding:9px 7px;border-bottom:1px solid #20334a;text-align:left}.ranktable th{color:#8fa4bd;font-weight:700}.scroll{overflow:auto}.ruleflow{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.step{background:#132137;border:1px solid var(--line);border-radius:13px;padding:13px}.step .n{font-size:11px;color:var(--blue);font-weight:850}.step h3{margin:4px 0 6px;font-size:16px}.step p{margin:0;color:#bdcbdb;font-size:12px;line-height:1.6}.rulebox{margin:10px 0;border:1px solid var(--line);border-radius:12px;overflow:hidden}.rulebox summary{cursor:pointer;background:#132137;padding:13px;font-weight:800}.rulebody{padding:13px;font-size:13px;line-height:1.75;color:#c5d2e2}.rulebody b{color:#fff}.formula{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:#091421;border:1px solid #243a54;padding:9px;border-radius:8px;margin:7px 0;color:#d8e6f8}.note{background:#0e1a2a;border-left:3px solid #486d99;padding:10px 12px;color:#bccbdd;font-size:12px;line-height:1.6;margin:9px 0}.rotation-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.rotation-cell{border:1px solid var(--line);background:#101e30;border-radius:12px;padding:12px}.rotation-cell h3{font-size:13px;margin:0 0 7px}.rotation-cell p{font-size:12px;line-height:1.55;color:#b8c8dc;margin:0}.form{display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:8px}.form input,.btn{border:1px solid var(--line);background:#0d1928;color:#fff;border-radius:9px;padding:9px}.btn{cursor:pointer;font-weight:750}.primary{background:#254773}.pos{padding:12px 0;border-bottom:1px solid var(--line)}.poshead{display:flex;justify-content:space-between}.lines{font-size:12px;color:#bdcada;line-height:1.7}.actions{display:flex;gap:6px;margin-top:7px}.legacy{width:100%;height:76vh;border:1px solid var(--line);border-radius:12px;background:#fff}.link{color:#8cb7ff}.statusline{font-size:12px;color:var(--muted);margin-top:5px}.empty{padding:18px;text-align:center;color:#9caec4;border:1px dashed #314760;border-radius:12px}.datareq{color:var(--warn)}
@media(max-width:850px){.row,.ruleflow{grid-template-columns:repeat(2,1fr)}.action-strip,.picks,.rotation-summary{grid-template-columns:1fr}.top{display:block}.asof{text-align:left;margin-top:7px}.hero-title{font-size:26px}.form{grid-template-columns:1fr 1fr}.form .primary{grid-column:span 2}}@media(max-width:520px){.wrap{padding:12px}.row,.ruleflow{grid-template-columns:1fr}.card{padding:13px}.hero{padding:16px}.hero-title{font-size:23px}.ticker{font-size:24px}}
</style>
</head>
<body><div class="wrap">
<div class="top"><div class="brand"><h1>V38 運用ダッシュボード</h1><div class="sub">まず「今日どうするか」。細かい監査用語は必要な時だけ。</div></div><div class="asof" id="asof">データ読込中</div></div>
<div class="tabs"><button class="on" data-tab="today">今日の判断</button><button data-tab="ranking">候補ランキング</button><button data-tab="resetwatch">RSI30接近</button><button data-tab="rules">ルール解説</button><button data-tab="positions">保有株</button><button data-tab="detail">詳細データ</button><button data-tab="legacy">既存Dashboard</button></div>
<section id="today" class="panel on">
<div class="card hero"><div class="eyebrow">TODAY'S ACTION</div><div class="hero-title" id="todayAction">判定中</div><div class="hero-reason" id="todayReason">—</div><div class="row"><div class="mini"><span>通常個別株</span><b id="normalDecision">—</b></div><div class="mini"><span>TQQQ</span><b id="tqqqDecision">—</b></div><div class="mini"><span>保有株</span><b id="holdingDecision">—</b></div><div class="mini"><span>新規再開の条件</span><b id="resumeCondition">—</b></div></div></div>
